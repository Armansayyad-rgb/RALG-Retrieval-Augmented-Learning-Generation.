# RALG Engine - non-secret configuration template.
#
# Copy to .env and adjust paths/values for your environment.
# Do NOT commit real secrets. This file contains no secrets.

# Project root (defaults to repository root).
AI_PROJECT_ROOT=/app

# Data / checkpoints / logs directories.
AI_PROJECT_DATA_DIR=/app/data
AI_PROJECT_CHECKPOINTS_DIR=/app/checkpoints
AI_PROJECT_LOGS_DIR=/app/logs

# Model / tokenizer artifacts.
TOKENIZER_FILE=/app/data/tokenizer_v2.json
MODEL_FILE=/app/checkpoints/v2/reasoning_model_v1.pt

# Knowledge corpus (comma-separated paths).
KNOWLEDGE_FILES=/app/data/wikitext_v2.txt,/app/data/knowledge_extra_v1.txt

# Runtime upload directory.
RUNTIME_UPLOAD_DIR=/app/data/runtime_uploads

# Web UI server binding.
WEBUI_HOST=127.0.0.1
WEBUI_PORT=7860

# Generation / retrieval tunables.
MAX_INPUT_TOKENS=480
MAX_NEW_TOKENS=50
CONFIDENCE_THRESHOLD=0.80

# Security configuration (PR #71).
# Set API_TOKEN to enable bearer-token authentication on all non-health/ready endpoints.
# When unset, all endpoints remain open for local-development compatibility.
API_TOKEN=

# CORS configuration.
# CORS_ORIGINS: comma-separated list of allowed origins. When empty, CORS middleware is not added.
CORS_ORIGINS=
# CORS_CREDENTIALS: set to 1 to allow credentials (cookies, auth headers). Default: 0 (disabled).
CORS_CREDENTIALS=0
# CORS_METHODS: comma-separated allowed HTTP methods. Default: GET,POST,PUT,DELETE,OPTIONS.
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
# CORS_HEADERS: comma-separated allowed headers. Default: Authorization,Content-Type.
CORS_HEADERS=Authorization,Content-Type
