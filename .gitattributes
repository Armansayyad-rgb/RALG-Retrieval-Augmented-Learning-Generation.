# Deterministic line endings across platforms.
# Frozen evaluation files are byte-hashed and must remain LF.

*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf
